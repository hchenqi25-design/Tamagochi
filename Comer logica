using System;

class Comer
{
    public static int CalcularAumento(string alimento)
    {
        return alimento.ToLower() switch
        {
            "hamburguesa" => (int)(10 * 0.50),
            "caramelo" => (int)(10 * 0.25),
            "pan" => (int)(10 * 0.10),
            _ => 0
        };
    }
}

