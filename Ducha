class Limpieza
{
    public int Nivel { get; private set; } 

    public Limpieza()
    {
        Nivel = 10; 
    }


    public void Bajar()
    {
        Nivel = Math.Max(0, Nivel - 1);
        Console.WriteLine($"🧼⬇️ Limpieza baja a {Nivel}/10");
    }

    
    public void Duchar()
    {
        int aumento = (int)(10 * 0.10);

        Nivel = Math.Min(10, Nivel + aumento);
        Console.WriteLine($"🚿 Se ducha. Limpieza sube a {Nivel}/10");
    }

    public string Estado()
    {
        if (Nivel == 10) return "Muy limpio";
        if (Nivel >= 7) return "Limpio";
        if (Nivel >= 4) return "Sucio";
        return "Muy sucio";
    }
}
class Program
{
    static void Main(string[] args)
    {
        Limpieza limpieza = new Limpieza();

        while (true)
        {
            Console.WriteLine("\n--- ESTADO DE LIMPIEZA ---");
            Console.WriteLine($"Limpieza: {limpieza.Nivel}/10 ({limpieza.Estado()})");

            Console.WriteLine("\n¿Qué quieres hacer?");
            Console.WriteLine("1. Duchar (+10%)");
            Console.WriteLine("2. No ducharlo");

            Console.Write("Elige opción: ");
            string opcion = Console.ReadLine();

            switch (opcion)
            {
                case "1": limpieza.Duchar(); break;
                case "2": Console.WriteLine("No lo duchaste."); break;
                default: Console.WriteLine("Opción inválida."); break;
            }

            
            limpieza.Bajar();

            if (limpieza.Nivel == 0)
                Console.WriteLine("⚠️ Está extremadamente sucio.");
        }
    }
}
