using System;

class Persona
{
    public string Nombre { get; set; }
    public int Hambre { get; set; } 

    public Persona(string nombre, int hambre)
    {
        Nombre = nombre;
        Hambre = hambre;
    }

    public void BajarHambre()
    {
        Hambre = Math.Max(0, Hambre - 1);
        Console.WriteLine("⬇️ Nivel de comida disminuyó a {Hambre}/10 ({EstadoActual()})");
    }

    public void Comer(string alimento)
    {
        int aumento = alimento.ToLower() switch
        {
            "hamburguesa" => (int)(10 * 0.50),
            "caramelo" => (int)(10 * 0.25),
            "pan" => (int)(10 * 0.10),
            _ => 0
        };

        if (aumento == 0)
        {
            Console.WriteLine("❌ Ese alimento no existe.");
            return;
        }

        Console.WriteLine("{Nombre} come {alimento} (+{aumento} comida)");
        Hambre = Math.Min(10, Hambre + aumento);
        Console.WriteLine("🍽️ Nivel ahora: {Hambre}/10 ({EstadoActual()})");
    }

    public string EstadoActual()
    {
        if (Hambre == 10) return "Muy lleno";
        if (Hambre >= 7) return "Satisfecho";
        if (Hambre >= 4) return "Con hambre";
        return "Muerto de hambre";
    }
}

class Program
{
    static void Main(string[] args)
    {
        Persona mascota = new Persona("Mascota", 5);

        while (true)
        {
            Console.WriteLine("\n--- ESTADO ---");
            Console.WriteLine($"Nivel de comida: {mascota.Hambre}/10 ({mascota.EstadoActual()})");

            Console.WriteLine("\n¿Qué comida quieres darle?");
            Console.WriteLine("1. Hamburguesa (50%)");
            Console.WriteLine("2. Caramelo (25%)");
            Console.WriteLine("3. Pan (10%)");
            Console.WriteLine("4. No darle nada");

            Console.Write("Elige opción: ");
            string opcion = Console.ReadLine();

            switch (opcion)
            {
                case "1": mascota.Comer("hamburguesa"); break;
                case "2": mascota.Comer("caramelo"); break;
                case "3": mascota.Comer("pan"); break;
                case "4": Console.WriteLine("No le diste comida."); break;
                default: Console.WriteLine("Opción inválida."); break;
            }

            
            mascota.BajarHambre();

            if (mascota.Hambre == 0)
            {
                Console.WriteLine("\n⚠️ Tu mascota está MUERTA DE HAMBRE. Dale comida YA.");
            }
        }
    }
}
