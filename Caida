using System;
using System.Threading;

class Caida
{
    public static bool pocion_caida = false;

    public static void Jugar()
    {
        Console.Clear();
        Console.CursorVisible = false;

        const int Ancho = 20;
        const int Alto = 20;

        int pouX = Ancho / 2;
        int pouY = 2;

        int obstaculoY = Alto - 1;
        int obstaculoX = 0;
        int obstaculoAncho = 6;

        Random rand = new Random();
        bool gameOver = false;

        int distancia = 0;
        int meta = 1000;

         
        obstaculoX = rand.Next(0, Ancho - obstaculoAncho);

        while (!gameOver)
        {
        
            if (Console.KeyAvailable)
            {
                var tecla = Console.ReadKey(true);

                if (tecla.Key == ConsoleKey.LeftArrow && pouX > 0)
                    pouX--;

                if (tecla.Key == ConsoleKey.RightArrow && pouX < Ancho - 1)
                    pouX++;

                if (tecla.Key == ConsoleKey.Escape)
                {
                    Console.Clear();
                    return;
                }
            }

            
            obstaculoY--;

            if (obstaculoY < 0)
            {
                obstaculoY = Alto - 1;
                obstaculoX = rand.Next(0, Ancho - obstaculoAncho);
            }

    
            if (pouY == obstaculoY)
            {
                if (pouX >= obstaculoX && pouX <= obstaculoX + obstaculoAncho)
                {
                    gameOver = true;
                }
            }

        
            distancia++;

            
            if (distancia >= meta)
            {
                Console.Clear();
                Console.WriteLine("🪂 ¡HAS SOBREVIVIDO A LA CAÍDA! 🪂");
                Console.WriteLine($"Distancia recorrida: {distancia} metros");

                
                if (!Program.pocionesBloqueadas && !Program.caidaObtenida)
                {
                    pocion_caida = true;
                    Program.caidaObtenida = true;

                    Console.WriteLine("\n🏺 ¡Has obtenido la pocion_caida! 🧪");
                }
                else
                {
                    Console.WriteLine("\n⚠ No puedes obtener más pociones de este minijuego.");
                }

                Console.WriteLine("\nPulsa una tecla para volver...");
                Console.ReadKey(true);
                Console.Clear();
                return;
            }

        
            Console.SetCursorPosition(0, 0);

            for (int y = 0; y < Alto; y++)
            {
                for (int x = 0; x < Ancho; x++)
                {
                    if (x == pouX && y == pouY)
                        Console.Write("P");
                    else if (y == obstaculoY && x >= obstaculoX && x <= obstaculoX + obstaculoAncho)
                        Console.Write("#");
                    else
                        Console.Write(" ");
                }
                Console.WriteLine();
            }

            Console.WriteLine($"Distancia: {distancia} m / {meta} m");
            Console.WriteLine("← → para moverte | ESC para salir");

            Thread.Sleep(80);
        }

    
        int mensajeY = Math.Min(Alto - 1, Console.WindowHeight - 2);
        Console.SetCursorPosition(0, mensajeY);

        Console.WriteLine("💀 GAME OVER 💀");
        Console.WriteLine($"Distancia recorrida: {distancia} metros");
        Console.WriteLine("Pulsa una tecla para volver...");
        Console.ReadKey(true);
        Console.Clear();

    }
}
