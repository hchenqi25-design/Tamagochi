using System;

class Salud
{
    public int Nivel { get; private set; }

    public Salud(int nivelInicial)
    {
        Nivel = nivelInicial;
    }

    public void Bajar()
    {
        Nivel = Math.Max(0, Nivel - 1);
    }

    public void Curar()
    {
        int aumento = 1; 
        Nivel = Math.Min(10, Nivel + aumento);

        Console.WriteLine($"Te has curado. Salud ahora: {Nivel}/10");
    }
}
