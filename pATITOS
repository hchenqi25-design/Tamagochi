    public void MatarPato()
    {
        huevo.SetActive(false);
        patoNormal.SetActive(false);
        patoElectrico.SetActive(false);
        patoFuego.SetActive(false);
        patoHielo.SetActive(false);

        AbrirPaneles();

        animacionPatoMuerto.SetActive(true);

        patoMuerto.gameObject.transform.Translate(Vector2.up * 2 * Time.deltaTime);

        StartCoroutine(EsperarYActivarText());
    }
    public IEnumerator EsperarYActivarText()
    {
        yield return new WaitForSeconds(3);
        BotonReinicioMuerte.gameObject.SetActive(true);
    }

    private IEnumerator ApareceFlechaYPuntos()
    {

        flechaSubir.gameObject.SetActive(true);
   
        yield return new WaitForSeconds(1);
        flechaSubir.gameObject.SetActive(false);

    }

    public void SalirPantallaPrincipal()//Salidas menos la del la pantalla normal (final)
    {
        panelNormal.SetActive(true);

        panelComidas.SetActive(false);
        panelMedicina.SetActive(false);
        panelJuegos.SetActive(false);
        panelSalidaTotal.SetActive(false);
       

        panelJuegoHielo.SetActive(false);
        //panelJuegoFuego.SetActive(false);
        panelJuegoElectricidad.SetActive(false);
        boolElectr.movRaton = true;

        ReiniciarJuegoHielo();
        ReiniciarJuegoElectrico();
       
        CerrarPaneles();

    }

