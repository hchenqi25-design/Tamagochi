    void Update()
    {
        nivel.text = ("Lv: " + contNiv);

        if (tiempo == true)//Tiempo
        {

            segundos += Time.deltaTime;

        
            if (segundos >= 60)
            {
                segundos = 0;
                minutos += 1;

            }

            if ((minutos == 1)&& (segundos == 0))
            {
                contNiv = 2;
                huevo.SetActive(false);
                patoNormal.SetActive(true);

            }

            if ((minutos == 1) && (segundos == 0))
            {
                
                candado.SetActive(false);
                curaBoton.interactable = true;
                desbloquearJuegos = true;
                juegosBoton.interactable = true;

            }

            if (contNiv == 3)
            {
                pocionHielo.gameObject.SetActive(false);
                pocionFuego.gameObject.SetActive(false);
                pocionElectricidad.gameObject.SetActive(false);
            }
        }
        Debug.Log(minutos + ":" + segundos);

        //Barras cuidado
        rellenoBarraComida.fillAmount = hambre / barraMaximo;
        rellenoBarraLimpieza.fillAmount = limpieza / barraMaximo;
        rellenoBarraSalud.fillAmount = salud / barraMaximo;
        rellenoBarraCuidado.fillAmount = cuidados / barraMaximo;

        if (hambre > 10)//BARRAS MAXIMO
        {
            hambre = 10;
            
        }
        if(limpieza > 10)
        {
            limpieza = 10;
        }
        if (salud > 10)
        {
            salud = 10;
        }
        if(cuidados > 10)
        {
           cuidados = 10;
        }
       
       /* if (tiempo == true)
        {
            hambre -= danoPorSegundo * Time.deltaTime * 0.2f;
            limpieza -= danoPorSegundo * Time.deltaTime * 0.06f;
            salud -= danoPorSegundo * Time.deltaTime * 0.4f;
            cuidados -= danoPorSegundo * Time.deltaTime * 0.05f;
        }*/

       if((hambre<=0)|| (limpieza <= 0) || (salud <= 0) || (cuidados <= 0))
        {
            MatarPato();
        }

    }

    void Start()
