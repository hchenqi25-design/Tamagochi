    //DuchaBotón
    public void PulsarBotonDucha()
    {

        StartCoroutine(MostrarDucha());
        
        limpieza += 3;
        barras.SetActive(true);

        numeroFlecha.text = ("+" + 3);
        StartCoroutine(ApareceFlechaYPuntos());

    }
    private IEnumerator MostrarDucha()
    {

        ducha.SetActive(true);
        AbrirPaneles();
        yield return new WaitForSeconds(3);
        ducha.SetActive(false);
        CerrarPaneles() ;

    }


    //CuidadosBoton
    public void PulsarBotonCuidados()
    {

        StartCoroutine(MostrarMano());

        cuidados += 2;
        barras.SetActive(true);


        numeroFlecha.text = ("+" + 2);
        StartCoroutine(ApareceFlechaYPuntos());

    }
    private IEnumerator MostrarMano()
    {

        mano.SetActive(true);
        AbrirPaneles() ;
        yield return new WaitForSeconds(3);
        mano.SetActive(false);
        CerrarPaneles() ;

    }

