using System;
using System.Threading;

class Mimos
{
    public int Nivel { get; private set; }

    public Mimos(int nivelInicial)
    {
        Nivel = nivelInicial;
    }

    public void DarMimos()
    {
        Nivel += 1;
        if (Nivel > 10)
            Nivel = 10;

        Console.WriteLine("\n Le has dado mimos a tu mascota. ¡Está más feliz!");
        Thread.Sleep(1500);
    }

    public void Bajar()
    {
        Nivel -= 1;
        if (Nivel < 0)
            Nivel = 0;
    }
}
