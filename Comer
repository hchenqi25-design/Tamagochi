using System;

class Comer
{
    public int Hambre { get; private set; }

    public Comer(int hambreInicial)
    {
        Hambre = hambreInicial;
    }

    public void BajarHambre()
    {
        Hambre = Math.Max(0, Hambre - 1);
    }

    public void ComerAlimento(string alimento)
    {
        int aumento = alimento.ToLower() switch
        {
            "hamburguesa" => (int)(10 * 0.50),
            "caramelo" => (int)(10 * 0.25),
            "pan" => (int)(10 * 0.10),
            _ => 0
        };

        Hambre = Math.Min(10, Hambre + aumento);
    }

    public string EstadoActual()
    {
        if (Hambre == 10) return "Muy lleno";
        if (Hambre >= 7) return "Satisfecho";
        if (Hambre >= 4) return "Con hambre";
        return "Muerto de hambre";
    }
}
