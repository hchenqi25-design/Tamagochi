using System.IO;
using System.Text.Json;

class DatosMascota
{
    public int hambre { get; set; }
    public int limpieza { get; set; }
    public int salud { get; set; }
    public int mimos { get; set; }
    public int nivel { get; set; }

    public bool jetObtenida { get; set; }
    public bool carreraObtenida { get; set; }
    public bool caidaObtenida { get; set; }
    public bool pocionesBloqueadas { get; set; }

    public int tiempoJugado { get; set; } // ⬅ NUEVO
}

class Guardado
{
    private static string ruta = "datosMascota.json";

    public static void Guardar(int hambre, int limpieza, int salud, int mimos, int nivel,
                               bool jetObtenida, bool carreraObtenida, bool caidaObtenida,
                               bool pocionesBloqueadas, int tiempoJugado)
    {
        var datos = new DatosMascota
        {
            hambre = hambre,
            limpieza = limpieza,
            salud = salud,
            mimos = mimos,
            nivel = nivel,
            jetObtenida = jetObtenida,
            carreraObtenida = carreraObtenida,
            caidaObtenida = caidaObtenida,
            pocionesBloqueadas = pocionesBloqueadas,
            tiempoJugado = tiempoJugado
        };

        string json = JsonSerializer.Serialize(datos, new JsonSerializerOptions { WriteIndented = true });
        File.WriteAllText(ruta, json);
    }

    public static (int hambre, int limpieza, int salud, int mimos, int nivel,
                   bool jetObtenida, bool carreraObtenida, bool caidaObtenida,
                   bool pocionesBloqueadas, int tiempoJugado) Cargar()
    {
        if (!File.Exists(ruta))
        {
            return (10, 10, 10, 10, 1, false, false, false, false, 0);
        }

        string json = File.ReadAllText(ruta);
        DatosMascota datos = JsonSerializer.Deserialize<DatosMascota>(json);

        return (datos.hambre, datos.limpieza, datos.salud, datos.mimos, datos.nivel,
                datos.jetObtenida, datos.carreraObtenida, datos.caidaObtenida,
                datos.pocionesBloqueadas, datos.tiempoJugado);
    }
}
