using System;
using System.Collections;
using System.Collections.Generic;
using UnityEngine;
using UnityEngine.UI;
using TMPro;
using Unity.VisualScripting;


public class AccionesBoton : MonoBehaviour
{

    public int hambre=10;
    public int salud=10;
    public int limpieza=10;
    public int cuidados=10;


    //Panel principal
    public GameObject panelNormal;
    public Button comidaBoton;
    public Button curaBoton;
    public Button duchaBoton;
    public Button cuidadoBoton;
    public Button juegosBoton;
    public Button salidaTotalBoton;


    public Button iniciarJuego;
    public Button confirmarNombre;
    public TMP_Text textoInicio;
    public TMP_InputField inputNombre;

    //Primer panel
    public GameObject panelInicio;
    public TMP_InputField introduccionNombre;


    public TMP_Text nombre;
    public TMP_Text nivel;


    //Botones comida
    public GameObject panelComidas;
    public Button hamburguesa;
    public Button caramelo;
    public Button pan;
    public Button salirComidas;
    
    //Botones medicina
    public GameObject panelMedicina;
    public Button medicina1;
    public Button medicina2;
    public Button medicina3;
    public Button salirMedicinas;

    //Botones ducha
    public GameObject ducha;

    //Botones cuidados
    public GameObject mano;

    //Botones juegos
    public GameObject panelJuegos;
    public Button juegos1;
    public Button juegos2;
    public Button juegos3;
    public Button salidaJuegos;



    void Update()
    {
        
    }


    void Start()
    {
        panelNormal.SetActive(false);
        panelInicio.SetActive(true);
        confirmarNombre.gameObject.SetActive(false);
        textoInicio.gameObject.SetActive(false);
        inputNombre.gameObject.SetActive(false);
    }


    public void AbrirPaneles()
    {
        comidaBoton.interactable = false;
        curaBoton.interactable = false;
        duchaBoton.interactable = false;
        cuidadoBoton.interactable = false;
        comidaBoton.interactable = false;
        juegosBoton.interactable = false;
        salidaTotalBoton.interactable = false;

        Color nuevaOpacidadNivel = nivel.color;
        nuevaOpacidadNivel.a = 0.5f;
        nivel.color = nuevaOpacidadNivel;

        Color nuevaOpacidadNombre = nombre.color;
        nuevaOpacidadNombre.a = 0.5f;
        nombre.color = nuevaOpacidadNombre;


    }

    public void CerrarPaneles()
    {
        comidaBoton.interactable = true;
        curaBoton.interactable = true;
        duchaBoton.interactable = true;
        cuidadoBoton.interactable = true;
        comidaBoton.interactable = true;
        juegosBoton.interactable = true;
        salidaTotalBoton.interactable = true;

        Color nuevaOpacidadNivel = nivel.color;
        nuevaOpacidadNivel.a = 1f;
        nivel.color = nuevaOpacidadNivel;

        Color nuevaOpacidadNombre = nombre.color;
        nuevaOpacidadNombre.a = 1f;
        nombre.color = nuevaOpacidadNombre;
    }

    //Panel principal 1
    public void IniciarJuego()
    {

        iniciarJuego.gameObject.SetActive(false);
        confirmarNombre.gameObject.SetActive(true);
        textoInicio.gameObject.SetActive(true);
        inputNombre.gameObject.SetActive(true);

    }

    //Panel principal 2
    public void ConfirmarNombre()
    {
        panelNormal.SetActive(true);
        nombre.text = introduccionNombre.text;
        panelInicio.SetActive(false);

    }


    //ComidaBotón
    public void PulsarBotonComida()
    {

        panelComidas.SetActive(true);
        AbrirPaneles();


    }
    public void DarComida(int valor)
    {
        hambre += valor;
        panelComidas.SetActive(false);
        CerrarPaneles();
    }
    

    //SaludBotón
    public void PulsarBotonSalud()
    {

        panelMedicina.SetActive(true);
        AbrirPaneles();

    }
    public void DarMedicina(int valor)
    {
        salud += valor;
        panelMedicina.SetActive(false);
        CerrarPaneles();
    }

    //DuchaBotón
    public void PulsarBotonDucha()
    {

        StartCoroutine(MostrarDucha());

        limpieza += 3;

    }
    private IEnumerator MostrarDucha()
    {

        ducha.SetActive(true);
        AbrirPaneles();
        yield return new WaitForSeconds(3);
        ducha.SetActive(false);
        CerrarPaneles() ;

    }


    //CuidadosBoton
    public void PulsarBotonCuidados()
    {

        StartCoroutine(MostrarMano());

        cuidados += 2;

    }
    private IEnumerator MostrarMano()
    {

        mano.SetActive(true);
        AbrirPaneles() ;
        yield return new WaitForSeconds(3);
        mano.SetActive(false);
        CerrarPaneles() ;

    }

    //JuegosBotón
    public void PulsarBotonJuegos()
    {

        panelJuegos.SetActive(true);
        AbrirPaneles();

    }



    public void SalirPantallaPrincipal()//Salidas menos la del la pantalla normal
    {
        panelComidas.SetActive(false);
        panelMedicina.SetActive(false);
        panelJuegos.SetActive(false);
        CerrarPaneles();

    }

   

}
