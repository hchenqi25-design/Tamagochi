using System;
using System.Threading;

class Program
{
    public static bool jetObtenida;
    public static bool carreraObtenida;
    public static bool caidaObtenida;
    public static bool pocionesBloqueadas;

    static void Main(string[] args)
    {
        var datos = Guardado.Cargar();

        Persona mascota = new Persona("Mascota", datos.hambre);
        Limpieza ducha = new Limpieza(datos.limpieza);
        Salud salud = new Salud(datos.salud);
        Nivel nivel = new Nivel(datos.nivel);

        jetObtenida = datos.jetObtenida;
        carreraObtenida = datos.carreraObtenida;
        caidaObtenida = datos.caidaObtenida;
        pocionesBloqueadas = datos.pocionesBloqueadas;

        Random rand = new Random();
        int tiempoParaBajar = 8;
        DateTime proximaBajada = DateTime.Now.AddSeconds(tiempoParaBajar);
        int barraActual = rand.Next(1, 4);

        bool primeraVez = true;

        while (true)
        {
            if (!primeraVez)
                Console.Clear();
            primeraVez = false;

            // BAJADA AUTOMÁTICA
            if (DateTime.Now >= proximaBajada)
            {
                if (barraActual == 1) mascota.BajarHambre();
                else if (barraActual == 2) ducha.Bajar();
                else if (barraActual == 3) salud.Bajar();

                int nuevaBarra;
                do nuevaBarra = rand.Next(1, 4);
                while (nuevaBarra == barraActual);

                barraActual = nuevaBarra;

                if (tiempoParaBajar > 3) tiempoParaBajar--;

                proximaBajada = DateTime.Now.AddSeconds(tiempoParaBajar);

                Guardado.Guardar(mascota.Hambre, ducha.Nivel, salud.Nivel, nivel.Valor,
                                 jetObtenida, carreraObtenida, caidaObtenida,
                                 pocionesBloqueadas);
            }

            // ESTADO
            Console.WriteLine("--- ESTADO ---");
            Console.WriteLine($"Comida: {mascota.Hambre}/10 ({mascota.EstadoActual()})");
            Console.WriteLine($"Limpieza: {ducha.Nivel}/10");
            Console.WriteLine($"Salud: {salud.Nivel}/10");
            Console.WriteLine($"Nivel: {nivel.Valor}");

            if (nivel.Valor < 3)
                Console.WriteLine($"Progreso nivel: {nivel.Progreso}/{nivel.ProgresoNecesario}");
            else
                Console.WriteLine("Progreso nivel: COMPLETADO ✔");

            // INVENTARIO
            Console.WriteLine("\n--- INVENTARIO DE POCIONES ---");
            Console.WriteLine($"Poción Jet: {(Jet.pocion_jet ? 1 : 0)}");
            Console.WriteLine($"Poción Carrera: {(Salto.pocion_carrera ? 1 : 0)}");
            Console.WriteLine($"Poción Caída: {(Caida.pocion_caida ? 1 : 0)}");

            Console.WriteLine(pocionesBloqueadas
                ? "Estado de pociones: BLOQUEADAS ❌"
                : "Estado de pociones: DISPONIBLES ✔");

            if (nivel.SubioDeNivel)
            {
                Console.WriteLine($"\n🎉 ¡TU MASCOTA HA SUBIDO A NIVEL {nivel.Valor}! 🎉");
                nivel.ResetSubida();
                Thread.Sleep(2000);
            }

            // MENÚ
            Console.WriteLine("\n¿Qué quieres hacer?");
            Console.WriteLine("1. Dar hamburguesa");
            Console.WriteLine("2. Dar caramelo");
            Console.WriteLine("3. Dar pan");
            Console.WriteLine("4. Duchar");
            Console.WriteLine("5. Curar");
            Console.WriteLine("6. Salir");
            Console.WriteLine("7. Jugar Jetpack");
            Console.WriteLine("8. Jugar Dino Pou");
            Console.WriteLine("9. Jugar Caída Libre");
            Console.WriteLine("10. Usar poción Jet");
            Console.WriteLine("11. Usar poción Carrera");
            Console.WriteLine("12. Usar poción Caída");

            Console.Write("Elige opción: ");
            string opcion = Console.ReadLine();

            // ACCIONES
            if (opcion == "1") { mascota.Comer("hamburguesa"); nivel.AumentarProgreso(); }
            else if (opcion == "2") { mascota.Comer("caramelo"); nivel.AumentarProgreso(); }
            else if (opcion == "3") { mascota.Comer("pan"); nivel.AumentarProgreso(); }
            else if (opcion == "4") { ducha.Duchar(mascota.Hambre); nivel.AumentarProgreso(); }
            else if (opcion == "5") { salud.Curar(); nivel.AumentarProgreso(); }
            else if (opcion == "6")
            {
                Guardado.Guardar(mascota.Hambre, ducha.Nivel, salud.Nivel, nivel.Valor,
                                 jetObtenida, carreraObtenida, caidaObtenida,
                                 pocionesBloqueadas);
                return;
            }
            else if (opcion == "7")
            {
                if (nivel.Valor < 2) { Console.WriteLine("\n❌ Nivel insuficiente."); Thread.Sleep(1500); }
                else { Jet.Jugar(); mascota.BajarHambre(); }
            }
            else if (opcion == "8")
            {
                if (nivel.Valor < 2) { Console.WriteLine("\n❌ Nivel insuficiente."); Thread.Sleep(1500); }
                else { Salto.Jugar(); mascota.BajarHambre(); }
            }
            else if (opcion == "9")
            {
                if (nivel.Valor < 2) { Console.WriteLine("\n❌ Nivel insuficiente."); Thread.Sleep(1500); }
                else { Caida.Jugar(); mascota.BajarHambre(); }
            }

            // USAR POCIONES
            else if (opcion == "10") // Jet
            {
                if (!Jet.pocion_jet)
                {
                    Console.WriteLine("\n❌ No tienes la pocion_jet.");
                    Thread.Sleep(1500);
                }
                else
                {
                    Jet.pocion_jet = false;
                    Salto.pocion_carrera = false;
                    Caida.pocion_caida = false;
                    pocionesBloqueadas = true;

                    Console.WriteLine("\n✔ Poción Jet usada con éxito.");
                    Thread.Sleep(2000);
                }
            }
            else if (opcion == "11") // Carrera
            {
                if (!Salto.pocion_carrera)
                {
                    Console.WriteLine("\n❌ No tienes la pocion_carrera.");
                    Thread.Sleep(1500);
                }
                else
                {
                    Salto.pocion_carrera = false;
                    Jet.pocion_jet = false;
                    Caida.pocion_caida = false;
                    pocionesBloqueadas = true;

                    Console.WriteLine("\n✔ Poción Carrera usada con éxito.");
                    Thread.Sleep(2000);
                }
            }
            else if (opcion == "12") // Caída
            {
                if (!Caida.pocion_caida)
                {
                    Console.WriteLine("\n❌ No tienes la pocion_caida.");
                    Thread.Sleep(1500);
                }
                else
                {
                    Caida.pocion_caida = false;
                    Jet.pocion_jet = false;
                    Salto.pocion_carrera = false;
                    pocionesBloqueadas = true;

                    Console.WriteLine("\n✔ Poción Caída usada con éxito.");
                    Thread.Sleep(2000);
                }
            }

            Guardado.Guardar(mascota.Hambre, ducha.Nivel, salud.Nivel, nivel.Valor,
                             jetObtenida, carreraObtenida, caidaObtenida,
                             pocionesBloqueadas);
        }
    }
}
