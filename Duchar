using System;
using System.IO;

class Limpieza
{
    private static string ruta = "datosMascota.txt";

    public int Nivel { get; private set; }

    public Limpieza(int nivelInicial)
    {
        Nivel = nivelInicial;
    }

    public void Bajar()
    {
        Nivel = Math.Max(0, Nivel - 1);
        Console.WriteLine($"🧼⬇️ Limpieza disminuyó a {Nivel}/10");
    }

    public void Duchar(int hambreActual)
    {
        int aumento = 1; // +10%
        Nivel = Math.Min(10, Nivel + aumento);

        Console.WriteLine($"🚿 Te duchaste. Limpieza ahora: {Nivel}/10");


        Guardar(hambreActual, Nivel);
    }

    public static void Guardar(int hambre, int limpieza)
    {
        File.WriteAllText(ruta, $"{hambre};{limpieza}");
        Console.WriteLine("Datos guardados automáticamente (hambre + limpieza).");
    }


    public static (int hambre, int limpieza) Cargar()
    {
        if (!File.Exists(ruta))
        {
            Console.WriteLine("⚠️ No hay datos guardados. Se inicia desde cero.");
            return (5, 10); // valores por defecto
        }

        string contenido = File.ReadAllText(ruta);
        string[] partes = contenido.Split(';');

        int hambre = int.Parse(partes[0]);
        int limpieza = int.Parse(partes[1]);

        return (hambre, limpieza);
    }
}
